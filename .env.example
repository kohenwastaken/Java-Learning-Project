# Copy this file as ".env" before starting the application:
#
#   cp .env.example .env
#
# Then replace the value below with your own local database password.
#
# This password is used for:
# 1. Creating the PostgreSQL "bank_user" user when the Docker database
#    is initialized for the first time.
# 2. Allowing the Spring Boot application to connect to PostgreSQL.
#
# Do NOT use this example value as a real password.
# Do NOT commit your real .env file to Git.
#
# You can generate a random password on macOS/Linux with:
#
#   openssl rand -hex 24

BANK_DB_PASSWORD=CHANGE_ME_BEFORE_RUNNING